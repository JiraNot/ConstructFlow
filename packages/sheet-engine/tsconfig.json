{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "paths": {
      "@constructflow/representation-engine": ["../representation-engine/dist/index.d.ts"],
      "@constructflow/domain-providers": [
        "../domain-providers/dist/index.d.ts"
      ],
      "@constructflow/geometry-kernel": [
        "../geometry-kernel/dist/index.d.ts"
      ],
      "@constructflow/structure-engine": [
        "../structure-engine/dist/index.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
