{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "declaration": true, "outDir": "./dist", "rootDir": "./src",
    "strict": true, "skipLibCheck": true,
    "paths": {
      "@constructflow/project-model": ["../project-model/dist/index.d.ts"],
      "@constructflow/command-schema": ["../command-schema/dist/index.d.ts"],
      "@constructflow/structure-engine": ["../structure-engine/dist/index.d.ts"],
      "@constructflow/architecture-engine": ["../architecture-engine/dist/index.d.ts"],
      "@constructflow/catalog-engine": ["../catalog-engine/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*"]
}
