{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constructflow.dev/schemas/module-manifest.schema.json",
  "title": "ConstructFlow Module Manifest",
  "type": "object",
  "required": ["id", "name", "version", "schema_version", "provides"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^constructflow\\.[a-z0-9_.-]+$"
    },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "integer", "minimum": 1 },
    "requires": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "optional": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "provides": {
      "type": "object",
      "properties": {
        "object_types": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "commands": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "validators": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
