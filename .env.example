# Set this to the exact public origin of the editor when enabling the AI profile.
CONSTRUCTFLOW_AI_ALLOWED_ORIGINS=https://constructflow.example.com

# Generate a private random value of at least 32 characters. The user enters this
# same token in the editor's AI panel; it is not baked into the frontend.
CONSTRUCTFLOW_AI_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
OPENAI_API_KEY=replace-with-provider-api-key
CONSTRUCTFLOW_AI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible HTTPS endpoint:
# CONSTRUCTFLOW_AI_BASE_URL=https://api.openai.com/v1/chat/completions
